# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 任意 OpenAI 兼容、支持 function calling 的接口均可，以下为 DeepSeek 示例。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填写你的Key
LLM_MODEL=deepseek-chat

# 其他示例（任选其一替换上面三行）：
# 通义千问（阿里云百炼）：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 离线 Mock（python main.py run-all --mock）无需任何配置。
